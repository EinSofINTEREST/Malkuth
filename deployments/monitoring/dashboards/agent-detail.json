{
  "title": "Malkuth — Agent Detail",
  "uid": "malkuth-agent-detail",
  "description": "Per-agent task latency, tool breakdown, model usage, restarts",
  "templating": [{"name": "agent", "query": "label_values(malkuth_agent_health, agent)"}],
  "panels": [
    {"title": "Task latency p50/p95", "type": "timeseries",
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le) (rate(malkuth_agent_task_duration_seconds_bucket{agent=\"$agent\"}[5m])))"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(malkuth_agent_task_duration_seconds_bucket{agent=\"$agent\"}[5m])))"}
     ]},
    {"title": "Tool calls by source", "type": "timeseries",
     "targets": [{"expr": "sum by (source, status) (rate(malkuth_tool_calls_total{agent=\"$agent\"}[5m]))"}]},
    {"title": "Model requests", "type": "timeseries",
     "targets": [{"expr": "sum by (model, status) (rate(malkuth_model_requests_total{agent=\"$agent\"}[5m]))"}]},
    {"title": "Tokens", "type": "timeseries",
     "targets": [{"expr": "sum by (direction) (rate(malkuth_model_tokens_total{agent=\"$agent\"}[5m]))"}]},
    {"title": "Restarts by reason", "type": "timeseries",
     "targets": [{"expr": "sum by (reason) (increase(malkuth_container_restarts_total{agent=\"$agent\"}[1h]))"}]},
    {"title": "Health", "type": "stat",
     "targets": [{"expr": "malkuth_agent_health{agent=\"$agent\"}"}]},
    {"title": "Recall tokens injected", "type": "timeseries",
     "targets": [{"expr": "malkuth_memory_recall_injected_tokens{agent=\"$agent\"}"}]}
  ]
}
