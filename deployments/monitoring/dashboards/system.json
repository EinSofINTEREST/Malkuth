{
  "title": "Malkuth — System",
  "uid": "malkuth-system",
  "description": "Container counts, memory service load, index lag",
  "panels": [
    {
      "title": "Containers running by agent",
      "type": "timeseries",
      "targets": [
        {
          "expr": "malkuth_containers_running"
        }
      ]
    },
    {
      "title": "Restart rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (agent) (rate(malkuth_container_restarts_total[15m]))"
        }
      ]
    },
    {
      "title": "Memory operations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (space, op, status) (rate(malkuth_memory_operations_total[5m]))"
        }
      ]
    },
    {
      "title": "Memory search latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, space) (rate(malkuth_memory_search_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "title": "Memory entries per space",
      "type": "timeseries",
      "targets": [
        {
          "expr": "malkuth_memory_entries"
        }
      ]
    },
    {
      "title": "Index lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "malkuth_memory_index_lag_seconds"
        }
      ]
    },
    {
      "title": "Access decisions by outcome and source",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (resource, decision, source) (rate(malkuth_access_decisions_total[5m]))"
        }
      ]
    },
    {
      "title": "Grants, revocations and refusals",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (op, decided_by) (increase(malkuth_access_grants_total[1h]))"
        }
      ]
    },
    {
      "title": "Registry reachable per enforcement point",
      "type": "stat",
      "targets": [
        {
          "expr": "malkuth_access_registry_reachable"
        }
      ]
    },
    {
      "title": "Decision cache invalidations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (component) (rate(malkuth_access_cache_invalidations_total[5m]))"
        }
      ]
    }
  ]
}
